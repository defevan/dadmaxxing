{
	# Private static site — Traefik terminates at dad.defevan
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
		level INFO
	}

	root * /srv
	encode gzip

	handle /healthz {
		respond "ok" 200
	}

	handle {
		try_files {path} {path}/ /404.html
		file_server
	}
}
